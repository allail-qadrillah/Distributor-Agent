# Copy to .env and fill in. Never commit .env.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Phase 2 — Surplus Intelligence (OpenAI-compatible chat completions).
# Key from the Surplus dashboard (inf_...); model id from GET /v1/models
# (e.g. deepseek-v4.1-flash-1017). Base URL defaults to the documented canonical value.
OPENAI_API_KEY=
OPENAI_MODEL=
