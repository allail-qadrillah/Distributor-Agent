# Copy to .env and fill in. Never commit .env.

# Deployment environment: "production" (default, fail-closed) or
# "development" (documented bypasses below). Production refuses to start
# with INTENT_CLASSIFIER_ENABLED=false, and refuses WHATSAPP_BRIDGE_URL
# without WHATSAPP_BRIDGE_TOKEN.
APP_ENVIRONMENT=production

SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Phase 2 — Surplus Intelligence (OpenAI-compatible chat completions).
# Key from the Surplus dashboard (inf_...); model id from GET /v1/models
# (e.g. deepseek-v4.1-flash-1017). Base URL defaults to the documented canonical value.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.surplusintelligence.ai/v1

# Phase 3 — intent classifier. Separate OpenAI-compatible provider; NEVER
# falls back to the agent provider above. When enabled, BASE_URL/API_KEY/
# MODEL must be filled or the classifier fails closed (message -> human).
# Enabled=false bypasses the intent gate: DEVELOPMENT ONLY, production
# refuses to start with it.
INTENT_CLASSIFIER_ENABLED=true
INTENT_CLASSIFIER_BASE_URL=
INTENT_CLASSIFIER_API_KEY=
INTENT_CLASSIFIER_MODEL=
# INTENT_CLASSIFIER_CONFIDENCE_THRESHOLD=0.85
# INTENT_CLASSIFIER_TIMEOUT_SECONDS=5.0
# INTENT_CLASSIFIER_MAX_CONTEXT_MESSAGES=10

# Phase 3 — WhatsApp bridge (external Baileys/Node service, see
# docs/notes/P3-whatsapp-adapter.md). Token is sent as Bearer to the bridge.
# Production requires the token when the URL is set.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
# WHATSAPP_BRIDGE_TIMEOUT_SECONDS=15.0

# Phase 3 — API authentication (shared secrets, constant-time compare).
# Webhook routes (bridge -> app) check X-Webhook-Secret; operator routes
# check X-Operator-Token. Empty in PRODUCTION = every request rejected
# (fail closed). Empty in DEVELOPMENT = allowed (documented dev bypass).
# These are boundaries, not identity: no per-operator accounts yet.
WHATSAPP_WEBHOOK_SECRET=
OPERATOR_API_TOKEN=

# Phase 3 — outbox recovery. A 'sending' row older than this many seconds
# was a dispatcher that died mid-send; it is reconciled to 'unknown'
# (never resent automatically, only resolved by a delivery report).
# OUTBOX_STALE_SENDING_SECONDS=60.0

# Phase 3 — agent context bound. The agent replay input holds at most the
# newest N transcript messages (tool pairing preserved; the full
# transcript stays persisted for audit).
# AGENT_TRANSCRIPT_MAX_MESSAGES=200

# Phase 4 — WhatsApp bridge (services/whatsapp-bridge, Node/Baileys).
# The bridge reads these; WHATSAPP_BRIDGE_URL/TOKEN above stay the
# Python-side view of the same bridge. The bridge fails closed when
# WHATSAPP_BRIDGE_TOKEN, WHATSAPP_WEBHOOK_SECRET (shared with the value
# above), or WHATSAPP_BRIDGE_FASTAPI_URL is missing; the data dir and
# host/port/QR-mode values below are optional with defaults.
# In docker-compose the FastAPI URL is http://app:8000, not 127.0.0.1.
WHATSAPP_BRIDGE_DATA_DIR=data/whatsapp-bridge
# WHATSAPP_BRIDGE_HOST=127.0.0.1
# WHATSAPP_BRIDGE_PORT=3001
# WHATSAPP_BRIDGE_FASTAPI_URL=http://127.0.0.1:8000
# WHATSAPP_BRIDGE_QR_MODE=local  # local: QR in terminal; docker: bridge stops itself for local pairing
